{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plan-critic output",
  "description": "JSON contract for nexus-discipline plan-critic component.",
  "type": "object",
  "required": ["critique_completed", "findings", "blocking", "recommendation", "confidence", "summary"],
  "properties": {
    "critique_completed": {"type": "boolean", "const": true},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "category", "isa_section", "description", "evidence", "recommendation"],
        "properties": {
          "severity": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
          "category": {"type": "string", "enum": ["accuracy", "completeness", "consistency", "feasibility", "alignment"]},
          "isa_section": {"type": "string"},
          "description": {"type": "string", "minLength": 10},
          "evidence": {"type": "string"},
          "recommendation": {"type": "string", "minLength": 5}
        }
      }
    },
    "blocking": {"type": "boolean"},
    "recommendation": {"type": "string", "enum": ["accept", "revise", "reject"]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "summary": {"type": "string", "minLength": 10}
  }
}
